{
  "name": "periodictablepoker-game",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:play": "vite",
    "deploy": "npm run build && firebase deploy --only hosting",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:multiplayer": "node scripts/test-multiplayer.mjs",
    "emulators": "firebase emulators:start --only \"auth,firestore\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "android:release": "npm run cap:sync && cd android && .\\gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "firebase": "^10.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@testing-library/react": "^14.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^1.6.1",
    "jsdom": "^23.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.1.0"
  },
  "capacitor": {
    "android": {
      "allowMixedContent": true
    }
  }
}
